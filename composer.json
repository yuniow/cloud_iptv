{
    "name": "cloudiptv/cloudiptv",
    "description": "CloudIPTV - PHP IPTV直播源管理与分发系统",
    "version": "1.0.0",
    "type": "project",
    "license": "GPL-3.0",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*",
